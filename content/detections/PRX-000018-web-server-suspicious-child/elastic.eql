process where host.os.type == "windows" and event.type == "start" and
  (
    process.parent.name : ("caddy.exe", "httpd.exe", "nginx.exe", "php-cgi.exe", "php.exe", "tomcat.exe", "UMWorkerProcess.exe", "w3wp.exe", "ws_TomcatService.exe") or
    ?process.parent.pe.original_file_name : ("caddy.exe", "httpd.exe", "nginx.exe", "php-cgi.exe", "php.exe", "tomcat.exe", "UMWorkerProcess.exe", "w3wp.exe", "ws_TomcatService.exe") or
    ((process.parent.name : ("java.exe", "javaw.exe") or ?process.parent.pe.original_file_name : ("java.exe", "javaw.exe")) and
      (?process.parent.executable : ("*-tomcat-*", "*\\tomcat*") or ?process.parent.command_line : ("*CATALINA_HOME*", "*catalina.home*", "*catalina.jar*")))
  ) and
  (
    process.name : ("arp.exe", "at.exe", "bash.exe", "bitsadmin.exe", "certutil.exe", "cmd.exe", "cscript.exe", "dsget.exe", "hostname.exe", "nbtstat.exe", "net.exe", "net1.exe", "netdom.exe", "netsh.exe", "nltest.exe", "ntdsutil.exe", "powershell_ise.exe", "powershell.exe", "pwsh.exe", "qprocess.exe", "query.exe", "qwinsta.exe", "reg.exe", "rundll32.exe", "sc.exe", "sh.exe", "wmic.exe", "wscript.exe", "wusa.exe") or
    ?process.pe.original_file_name : ("arp.exe", "at.exe", "bash.exe", "bitsadmin.exe", "certutil.exe", "cmd.exe", "cscript.exe", "dsget.exe", "hostname.exe", "nbtstat.exe", "net.exe", "net1.exe", "netdom.exe", "netsh.exe", "nltest.exe", "ntdsutil.exe", "powershell_ise.exe", "powershell.exe", "pwsh.exe", "pwsh.dll", "qprocess.exe", "query.exe", "qwinsta.exe", "reg.exe", "rundll32.exe", "sc.exe", "sh.exe", "wmic.exe", "wscript.exe", "wusa.exe")
  )
