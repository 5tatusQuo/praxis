process where host.os.type == "windows" and event.type == "start" and
  (process.name : ("powershell.exe", "pwsh.exe") or
    ?process.pe.original_file_name : ("PowerShell.EXE", "pwsh.dll")) and
  process.command_line regex~ """.*[\-/](e|ec|en|enc|enco|encod|encode|encoded|encodedc|encodedco|encodedcom|encodedcomm|encodedcomma|encodedcomman|encodedcommand)\s+[A-Za-z0-9+/=]{100,}.*"""
